---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
---
<BaseLayout
  title="Request a consultation"
  description="Request a paid, appointment-only consultation with Munge Eba & Co. Law Firm in Bepanda, Douala, in person or remotely."
  locale="en"
  transparentHeader
>
  <PageHero
    eyebrow="Appointments"
    title="Request a consultation."
    body="Consultations are paid, offered in person or remotely, and scheduled by appointment. Share the broad nature of your matter; duration and response timing depend on the file."
  />
  <ContactForm locale="en" />
</BaseLayout>
