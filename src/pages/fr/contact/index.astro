---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
---
<BaseLayout
  title="Demander une consultation"
  description="Demandez une consultation payante et sur rendez-vous auprès de Munge Eba & Co. Law Firm à Bépanda, Douala, en personne ou à distance."
  locale="fr"
  transparentHeader
>
  <PageHero
    eyebrow="Rendez-vous"
    title="Demander une consultation."
    body="Les consultations sont payantes, en personne ou à distance, et uniquement sur rendez-vous. Indiquez la nature générale de votre dossier ; la durée et le délai de réponse dépendent de celui-ci."
  />
  <ContactForm locale="fr" />
</BaseLayout>
