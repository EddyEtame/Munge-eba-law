---
import PageHero from './PageHero.astro';
import ContactForm from './ContactForm.astro';
import { firm, type Locale } from '@/lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = locale === 'en' ? {
  eyebrow: 'The firm', title: 'Serious about the law. Human about the work.', body: 'Munge Eba Law is a Douala-based practice led by Munge Eba Ngwesse, serving clients with rigour, discretion and direct access to counsel.',
  profile: 'A practice built on responsibility.', p1: 'For more than eight years, Munge Eba Ngwesse has advised clients through decisions in which legal detail and practical consequence cannot be separated.', p2: 'The firm’s approach is intentionally personal. Matters are examined carefully, advice is expressed plainly, and clients are kept close to the reasoning that shapes each next step.',
  principles: ['Clarity', 'Discretion', 'Preparation', 'Accountability']
} : {
  eyebrow: 'Le cabinet', title: 'Exigeant sur le droit. Humain dans l’accompagnement.', body: 'Munge Eba Law est un cabinet basé à Douala et dirigé par Munge Eba Ngwesse, au service de ses clients avec rigueur, discrétion et accès direct à l’avocate.',
  profile: 'Une pratique fondée sur la responsabilité.', p1: 'Depuis plus de huit ans, Munge Eba Ngwesse accompagne ses clients dans des décisions où le détail juridique et la conséquence pratique sont indissociables.', p2: 'L’approche du cabinet est volontairement personnelle. Chaque dossier est étudié avec soin, le conseil est formulé clairement et le client reste associé au raisonnement qui détermine chaque étape.',
  principles: ['Clarté', 'Discrétion', 'Préparation', 'Responsabilité']
};
---
<PageHero eyebrow={c.eyebrow} title={c.title} body={c.body} />
<section class="about-profile content-section">
  <div class="container about-profile__grid">
    <div class="about-profile__mark" data-reveal><img src="/brand/munge-eba-logo-transparent.png" alt="Munge Eba & Co. Law Firm" width="700" height="700" /></div>
    <div data-reveal><p class="eyebrow">{firm.principal}</p><h2 class="section-title">{c.profile}</h2><p class="lede">{c.p1}</p><p class="lede">{c.p2}</p></div>
  </div>
  <div class="container about-principles">{c.principles.map((item, i) => <article data-reveal><span>0{i + 1}</span><h3>{item}</h3></article>)}</div>
</section>
<ContactForm locale={locale} />
<style>
  .about-profile__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 8rem; align-items: center; }
  .about-profile__mark { min-height: 38rem; display: grid; place-items: center; background: var(--oxblood-dark); overflow: hidden; }
  .about-profile__mark img { width: min(80%, 30rem); filter: drop-shadow(0 2rem 3rem rgba(0,0,0,.4)); transform: translateY(var(--parallax-y, 0px)); will-change: transform; }
  .about-profile .eyebrow { margin-bottom: 2rem; }
  .about-profile .lede { margin-top: 2rem; }
  .about-principles { margin-top: 8rem; display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid var(--line); }
  .about-principles article { min-height: 14rem; padding: 1.5rem; border-right: 1px solid var(--line); }
  .about-principles article:last-child { border-right: 0; }
  .about-principles span { color: var(--gold); font-size: .62rem; }
  .about-principles h3 { margin: 5rem 0 0; font: 500 2rem/1 var(--serif); }
  @media(max-width: 850px){ .about-profile__grid { grid-template-columns: 1fr; gap: 4rem; } .about-principles { grid-template-columns: 1fr 1fr; } .about-profile__mark { min-height: 28rem; } }
</style>
