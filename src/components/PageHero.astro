---
interface Props { eyebrow: string; title: string; body: string; }
const { eyebrow, title, body } = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero__inner">
    <div class="page-hero__top">
      <p class="page-hero__eyebrow">{eyebrow}</p>
      <span aria-hidden="true"></span>
    </div>
    <div class="page-hero__grid">
      <h1 class="display">{title}</h1>
      <p class="lede">{body}</p>
    </div>
  </div>
</section>

<style>
  .page-hero { min-height: clamp(25rem, 56svh, 42rem); display: grid; align-items: center; padding: 7.5rem 0 3.25rem; background: #171310; color: var(--paper-bright); }
  .page-hero__inner { display: grid; gap: clamp(2.5rem, 5vh, 4rem); }
  .page-hero__top { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.5rem; }
  .page-hero__top span { height: 1px; background: rgba(255,255,255,.22); }
  .page-hero__eyebrow { margin: 0; color: var(--gold-light); font-size: .65rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .page-hero__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(18rem, .7fr); align-items: end; gap: clamp(3rem, 8vw, 9rem); }
  .page-hero .display { max-width: 12ch; font-size: clamp(4rem, 6.2vw, 7.2rem); line-height: .88; text-wrap: balance; }
  .page-hero .lede { padding: 1.4rem 0 0 1.7rem; border-left: 1px solid var(--gold); color: rgba(255,255,255,.68); }
  .page-hero__top, .page-hero .display, .page-hero .lede { animation: page-hero-rise .7s var(--ease); }
  @keyframes page-hero-rise { from { transform: translateY(.8rem); } to { transform: none; } }
  @media(max-width: 820px) {
    .page-hero { min-height: auto; padding: 9rem 0 4.5rem; }
    .page-hero__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .page-hero .display { max-width: 10ch; }
    .page-hero .lede { max-width: 36rem; }
  }
  @media(max-width: 560px) {
    .page-hero { padding-top: 7.5rem; }
    .page-hero__inner { gap: 3rem; }
    .page-hero__top { gap: .9rem; }
    .page-hero .display { font-size: clamp(3.35rem, 16vw, 5rem); }
  }
  @media(prefers-reduced-motion: reduce) { .page-hero__top, .page-hero .display, .page-hero .lede { animation: none; } }
</style>
