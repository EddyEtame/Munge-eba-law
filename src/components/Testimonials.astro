---
import type { Locale } from '@/lib/site';
export interface Testimonial { quote: string; attribution: string; context?: string; }
interface Props { locale: Locale; items: Testimonial[]; }
const { locale, items } = Astro.props;
---
{items.length > 0 && (
  <section class="testimonials content-section">
    <div class="container testimonials__head"><p class="eyebrow">{locale === 'en' ? 'Client perspectives' : 'Paroles de clients'}</p><span>{String(items.length).padStart(2, '0')}</span></div>
    <div class="container testimonials__track">
      {items.map((item, index) => <figure data-reveal>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <blockquote class="serif">“{item.quote}”</blockquote>
        <figcaption><strong>{item.attribution}</strong>{item.context && <small>{item.context}</small>}</figcaption>
      </figure>)}
    </div>
  </section>
)}
<style>
  .testimonials { background: var(--gold); }
  .testimonials__head { display: flex; justify-content: space-between; border-bottom: 1px solid rgba(21,19,16,.25); padding-bottom: 1.5rem; }
  .testimonials__track { display: grid; grid-auto-flow: column; grid-auto-columns: min(80vw, 52rem); gap: 8rem; overflow-x: auto; padding-top: 5rem; scrollbar-width: thin; }
  .testimonials figure { min-height: 30rem; margin: 0; display: flex; flex-direction: column; }
  .testimonials figure > span { font-size: .62rem; }
  .testimonials blockquote { margin: auto 0; font-size: clamp(2.8rem, 5vw, 5.6rem); line-height: .94; letter-spacing: -.045em; }
  .testimonials figcaption { display: grid; gap: .3rem; padding-top: 2rem; border-top: 1px solid rgba(21,19,16,.25); font-size: .75rem; }
  .testimonials figcaption small { color: rgba(21,19,16,.62); }
</style>
