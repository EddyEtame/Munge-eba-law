---
import CinematicHero from './CinematicHero.astro';
import ContactForm from './ContactForm.astro';
import { content, firm, pathFor, services, type Locale } from '@/lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = content[locale];

const facts = locale === 'en'
  ? [
      ['In practice since', firm.practiceSince],
      ['Working languages', 'English and French'],
      ['Consultations', 'By appointment'],
    ]
  : [
      ['En exercice depuis', firm.practiceSince],
      ['Langues de travail', 'Français et anglais'],
      ['Consultations', 'Sur rendez-vous'],
    ];

const audiences = locale === 'en'
  ? [
      ['Foreign investors', 'Legal orientation for establishing and developing business activities in Cameroon.'],
      ['NGOs', 'Counsel for organisations working on human-rights questions.'],
      ['Individuals', 'Direct legal guidance shaped around the circumstances of the matter.'],
    ]
  : [
      ['Investisseurs étrangers', 'Orientation juridique pour implanter et développer des activités au Cameroun.'],
      ['ONG', 'Conseil des organisations actives sur les questions de droits humains.'],
      ['Particuliers', 'Un conseil juridique direct, adapté aux circonstances du dossier.'],
    ];
---

<CinematicHero locale={locale} />

<section class="positioning content-section">
  <div class="container positioning__grid">
    <p class="eyebrow" data-reveal>{t.home.introEyebrow}</p>
    <div>
      <h2 class="section-title" data-reveal>{t.home.introTitle}</h2>
      <p class="lede positioning__body" data-reveal>{t.home.introBody}</p>
    </div>
  </div>
  <dl class="container fact-rail" data-reveal>
    {facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
  </dl>
</section>

<section class="practice content-section" id="practice">
  <div class="container practice__heading">
    <div>
      <p class="eyebrow" data-reveal>{t.home.expertiseEyebrow}</p>
      <h2 class="section-title" data-reveal>{t.home.expertiseTitle}</h2>
    </div>
    <p class="lede" data-reveal>{t.home.expertiseBody}</p>
  </div>
  <div class="container practice__list">
    {services.map((service) => {
      const item = service[locale];
      return (
        <a class="practice-row" href={`${pathFor(locale, 'services')}${service.slug}/`} data-reveal>
          <span class="practice-row__number">{service.number}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </div>
          <span class="practice-row__action">{locale === 'en' ? 'View details' : 'Voir le détail'}</span>
        </a>
      );
    })}
  </div>
</section>

<section class="method content-section">
  <div class="container method__grid">
    <div class="method__heading">
      <p class="eyebrow" data-reveal>{t.home.approachEyebrow}</p>
      <h2 class="section-title" data-reveal>{t.home.approachTitle}</h2>
    </div>
    <div class="method__steps">
      {t.process.map(([number, title, body]) => (
        <article data-reveal>
          <span>{number}</span>
          <div><h3>{title}</h3><p>{body}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="partner content-section">
  <div class="container partner__grid">
    <div class="partner__credential" data-reveal>
      <div class="partner__tenure">
        <span>{locale === 'en' ? 'In practice since' : 'En exercice depuis'}</span>
        <strong>{firm.practiceSince}</strong>
      </div>
      <div class="partner__identity">
        <p>{firm.title[locale]}</p>
        <strong>{firm.principal}</strong>
        <span>{firm.admission[locale]}</span>
      </div>
    </div>
    <div class="partner__copy">
      <p class="eyebrow" data-reveal>{t.home.profileEyebrow}</p>
      <h2 class="section-title" data-reveal>{t.home.profileTitle}</h2>
      <p class="lede" data-reveal>{t.home.profileBody}</p>
      <a class="text-link" href={pathFor(locale, 'about')} data-reveal>{locale === 'en' ? 'About the firm' : 'Découvrir le cabinet'}</a>
    </div>
  </div>
</section>

<section class="audiences content-section">
  <div class="container audiences__heading">
    <p class="eyebrow" data-reveal>{t.home.audienceEyebrow}</p>
    <div><h2 class="section-title" data-reveal>{t.home.audienceTitle}</h2><p class="lede" data-reveal>{t.home.audienceBody}</p></div>
  </div>
  <div class="container audience-grid">
    {audiences.map(([title, body], index) => (
      <article data-reveal><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>
    ))}
  </div>
</section>

<ContactForm locale={locale} compact />

<style>
  .positioning { background: var(--paper-bright); }
  .positioning__grid { display: grid; grid-template-columns: minmax(12rem, .38fr) 1fr; gap: clamp(3rem, 9vw, 10rem); align-items: start; }
  .positioning__body { margin-top: 2.5rem; }
  .fact-rail { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(4rem, 8vw, 8rem); border-block: 1px solid var(--line); }
  .fact-rail div { min-height: 8.8rem; display: grid; align-content: space-between; gap: 1rem; padding: 1.35rem 1.6rem 1.5rem 0; border-right: 1px solid var(--line); }
  .fact-rail div:not(:first-child) { padding-left: 1.6rem; }
  .fact-rail div:last-child { border-right: 0; }
  .fact-rail dt { color: var(--muted); font-size: .63rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .fact-rail dd { margin: 0; font: 500 clamp(1.55rem, 2.2vw, 2.45rem)/1.05 var(--serif); }

  .practice { background: var(--paper); }
  .practice__heading { display: grid; grid-template-columns: 1fr minmax(20rem, 32rem); gap: 5rem; align-items: end; margin-bottom: clamp(4rem, 7vw, 7rem); }
  .practice .eyebrow, .method .eyebrow, .partner .eyebrow, .audiences .eyebrow { margin-bottom: 1.7rem; }
  .practice__list { border-top: 1px solid var(--line); }
  .practice-row { display: grid; grid-template-columns: 4rem 1fr auto; gap: clamp(1.5rem, 4vw, 5rem); align-items: center; min-height: 12rem; border-bottom: 1px solid var(--line); transition: background .35s var(--ease), padding .35s var(--ease); }
  .practice-row:hover { padding-inline: 1.2rem; background: rgba(255,255,255,.43); }
  .practice-row__number { align-self: start; padding-top: 2.6rem; color: var(--oxblood); font-size: .64rem; font-weight: 700; }
  .practice-row h3 { margin: 0; font: 500 clamp(2.8rem, 5vw, 6rem)/.9 var(--serif); letter-spacing: -.045em; }
  .practice-row p { max-width: 42rem; margin: .9rem 0 0; color: var(--muted); line-height: 1.6; }
  .practice-row__action, .text-link { border-bottom: 1px solid currentColor; padding-bottom: .3rem; color: var(--oxblood); font-size: .65rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }

  .method { background: var(--ink); color: var(--paper-bright); }
  .method .eyebrow { color: var(--gold-light); }
  .method__grid { display: grid; grid-template-columns: .82fr 1.18fr; gap: clamp(4rem, 10vw, 11rem); }
  .method__heading { align-self: start; position: sticky; top: 9rem; }
  .method__steps { border-top: 1px solid rgba(255,255,255,.18); }
  .method__steps article { display: grid; grid-template-columns: 3rem 1fr; gap: 2rem; padding: 2.5rem 0 3.2rem; border-bottom: 1px solid rgba(255,255,255,.18); }
  .method__steps article > span { color: var(--gold-light); font-size: .62rem; }
  .method__steps h3 { margin: 0 0 .8rem; font: 500 clamp(2.2rem, 3.7vw, 4.4rem)/.95 var(--serif); }
  .method__steps p { max-width: 31rem; margin: 0; color: rgba(255,255,255,.65); line-height: 1.7; }

  .partner { background: var(--paper-bright); }
  .partner__grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(4rem, 10vw, 11rem); align-items: center; }
  .partner__credential { min-height: 36rem; display: grid; align-content: space-between; padding: clamp(2rem, 5vw, 4rem); background: var(--oxblood-dark); color: white; }
  .partner__tenure { display: grid; gap: 1rem; }
  .partner__tenure span { color: var(--gold-light); font-size: .62rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .partner__tenure strong { color: rgba(255,255,255,.95); font: 500 clamp(5rem, 10vw, 9rem)/.8 var(--serif); letter-spacing: -.06em; }
  .partner__identity { display: grid; gap: .35rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,.22); }
  .partner__identity p { margin: 0 0 .65rem; color: var(--gold-light); font-size: .62rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .partner__identity strong { font: 500 clamp(2.1rem, 3.4vw, 3.9rem)/1 var(--serif); }
  .partner__identity span { color: rgba(255,255,255,.65); font-size: .78rem; }
  .partner__copy .lede { margin-top: 2.2rem; }
  .partner__copy .text-link { display: inline-block; margin-top: 2.4rem; }

  .audiences { background: var(--paper); }
  .audiences__heading { display: grid; grid-template-columns: .38fr 1fr; gap: clamp(3rem, 9vw, 10rem); }
  .audiences__heading .lede { margin-top: 2.2rem; }
  .audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(4rem, 7vw, 7rem); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .audience-grid article { min-height: 20rem; padding: 1.5rem 2rem 2rem 0; border-right: 1px solid var(--line); }
  .audience-grid article:not(:first-child) { padding-left: 2rem; }
  .audience-grid article:last-child { border-right: 0; }
  .audience-grid span { color: var(--oxblood); font-size: .62rem; font-weight: 700; }
  .audience-grid h3 { margin: 6rem 0 1rem; font: 500 clamp(2rem, 3vw, 3.4rem)/1 var(--serif); }
  .audience-grid p { margin: 0; color: var(--muted); line-height: 1.7; }

  @media(max-width: 900px) {
    .positioning__grid, .practice__heading, .method__grid, .partner__grid, .audiences__heading { grid-template-columns: 1fr; gap: 3rem; }
    .method__heading { position: static; }
    .partner__credential { min-height: 30rem; }
  }
  @media(max-width: 680px) {
    .fact-rail, .audience-grid { grid-template-columns: 1fr; }
    .fact-rail div, .fact-rail div:not(:first-child) { min-height: auto; padding: 1.3rem 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .fact-rail div:last-child { border-bottom: 0; }
    .practice-row { grid-template-columns: 2rem 1fr; gap: 1rem; min-height: 10rem; padding: 2rem 0; }
    .practice-row:hover { padding-inline: 0; }
    .practice-row__number { padding-top: .25rem; }
    .practice-row__action { grid-column: 2; justify-self: start; }
    .method__steps article { grid-template-columns: 2rem 1fr; gap: 1rem; }
    .partner__credential { min-height: 27rem; margin-inline: -14px; }
    .audience-grid article, .audience-grid article:not(:first-child) { min-height: auto; padding: 1.5rem 0 2.5rem; border-right: 0; border-bottom: 1px solid var(--line); }
    .audience-grid article:last-child { border-bottom: 0; }
    .audience-grid h3 { margin-top: 3rem; }
  }
</style>
