<div class="motion-progress" aria-hidden="true"><i data-scroll-progress></i></div>
<div class="motion-cursor" aria-hidden="true" data-motion-cursor><span></span></div>
<div class="page-veil" aria-hidden="true"><i></i><i></i><span>Munge Eba &amp; Co.</span></div>

<style is:global>
  .motion-progress { position: fixed; z-index: 120; inset: 0 0 auto; height: 2px; pointer-events: none; }
  .motion-progress i { display: block; width: 100%; height: 100%; background: var(--gold-light); transform: scaleX(0); transform-origin: left; will-change: transform; }
  .motion-cursor { position: fixed; z-index: 119; top: 0; left: 0; width: 2.5rem; height: 2.5rem; margin: -1.25rem 0 0 -1.25rem; border: 1px solid rgba(198,152,61,.72); border-radius: 50%; pointer-events: none; opacity: 0; transition: width .3s var(--ease), height .3s var(--ease), margin .3s var(--ease), background .3s, opacity .25s; mix-blend-mode: difference; }
  .motion-cursor span { position: absolute; inset: 50% auto auto 50%; width: 3px; height: 3px; border-radius: 50%; background: var(--gold-light); transform: translate(-50%,-50%); }
  .motion-cursor.is-active { width: 5rem; height: 5rem; margin: -2.5rem 0 0 -2.5rem; background: rgba(198,152,61,.13); }
  .page-veil { position: fixed; z-index: 150; inset: 0; display: grid; grid-template-columns: 1fr 1fr; pointer-events: none; animation: veil-away 0s linear 1.4s forwards; }
  .page-veil i { background: var(--oxblood-dark); transform: scaleX(1); will-change: transform; }
  .page-veil i:first-child { transform-origin: left; animation: veil-left 1.25s var(--ease) .18s forwards; }
  .page-veil i:nth-child(2) { transform-origin: right; animation: veil-right 1.25s var(--ease) .18s forwards; }
  .page-veil span { position: absolute; inset: 50% auto auto 50%; color: var(--gold-light); font: 500 clamp(.7rem,1vw,.85rem)/1 var(--sans); letter-spacing: .24em; text-transform: uppercase; white-space: nowrap; transform: translate(-50%,-50%); animation: veil-word 1s var(--ease) both; }
  @keyframes veil-left { to { transform: scaleX(0); } }
  @keyframes veil-right { to { transform: scaleX(0); } }
  @keyframes veil-word { 0% { opacity: 0; letter-spacing: .5em; } 35% { opacity: 1; } 75%,100% { opacity: 0; letter-spacing: .3em; } }
  @keyframes veil-away { to { visibility: hidden; } }
  .motion-title .motion-word { display: inline-block; overflow: hidden; margin: -.08em .11em -.16em 0; padding: .08em 0 .16em; vertical-align: top; }
  .motion-title .motion-word > span { display: inline-block; transform: translateY(118%) rotate(3deg); transform-origin: left bottom; filter: blur(5px); opacity: 0; transition: transform 1.05s var(--ease), filter 1s var(--ease), opacity .75s; transition-delay: calc(var(--word-index) * 55ms); }
  .motion-title.is-visible .motion-word > span { transform: translateY(0) rotate(0); filter: blur(0); opacity: 1; }
  .motion-line { position: relative; overflow: hidden; }
  .motion-line::after { content: ''; position: absolute; inset: auto 100% 0 0; height: 1px; background: currentColor; transition: right 1.1s var(--ease); }
  .motion-line.is-visible::after { right: 0; }
  [data-reveal] { filter: blur(7px); clip-path: inset(0 0 12% 0); transition-delay: calc(var(--reveal-index, 0) * 85ms); }
  [data-reveal].is-visible { filter: blur(0); clip-path: inset(0); }
  .eyebrow.motion-observed { opacity: 0; transform: translateX(-1.5rem); transition: opacity .75s var(--ease), transform .75s var(--ease); }
  .eyebrow.motion-observed::before { transform: scaleX(0); transform-origin: left; transition: transform .8s var(--ease) .2s; }
  .eyebrow.motion-observed.is-visible { opacity: 1; transform: none; }
  .eyebrow.motion-observed.is-visible::before { transform: scaleX(1); }
  .page-hero { --hero-drift: 0px; }
  .page-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 75% calc(38% + var(--hero-drift)), rgba(198,152,61,.2), transparent 20rem); pointer-events: none; }
  .page-hero > * { position: relative; }
  .site-header { animation: header-arrive .9s var(--ease) .8s both; }
  @keyframes header-arrive { from { opacity: 0; transform: translateY(-1.5rem); } to { opacity: 1; transform: none; } }
  .service-row i, .expertise-card__arrow { transition: transform .45s var(--ease); }
  .service-row:hover i { transform: translate(45%,-45%) rotate(45deg); }
  .about-principles article, .standard__metrics article, .service-detail li { position: relative; overflow: hidden; }
  .about-principles article::after, .standard__metrics article::after, .service-detail li::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent, rgba(198,152,61,.08), transparent); transform: translateX(-110%); transition: transform .8s var(--ease); pointer-events: none; }
  .about-principles article:hover::after, .standard__metrics article:hover::after, .service-detail li:hover::after { transform: translateX(110%); }
  .profile__halo { animation: halo-breathe 5s ease-in-out infinite alternate; }
  .process__seal { animation: seal-orbit 9s ease-in-out infinite alternate; }
  @keyframes halo-breathe { to { transform: scale(1.08); opacity: .72; } }
  @keyframes seal-orbit { to { transform: rotate(4deg) translateY(-.6rem); } }
  .footer__nav a { position: relative; }
  .footer__nav a::after { content: ''; position: absolute; inset: auto 100% -.3rem 0; height: 1px; background: var(--gold-light); transition: right .45s var(--ease); }
  .footer__nav a:hover::after { right: 0; }
  .consultation__form.is-visible .field, .consultation__form.is-visible .consent, .consultation__form.is-visible .button { animation: form-rise .8s var(--ease) both; }
  .consultation__form.is-visible .field:nth-child(3) { animation-delay: .08s; }
  .consultation__form.is-visible .field:nth-child(4) { animation-delay: .16s; }
  .consultation__form.is-visible .field:nth-child(5) { animation-delay: .24s; }
  .consultation__form.is-visible .consent { animation-delay: .31s; }
  .consultation__form.is-visible .button { animation-delay: .38s; }
  @keyframes form-rise { from { opacity: 0; transform: translateY(1.2rem); } to { opacity: 1; transform: none; } }
  @media (pointer: coarse) { .motion-cursor { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .motion-progress, .motion-cursor, .page-veil { display: none; }
    .motion-title .motion-word > span, .eyebrow.motion-observed { opacity: 1; transform: none; filter: none; }
    [data-reveal] { filter: none; clip-path: none; }
    .site-header, .profile__halo, .process__seal { animation: none; }
  }
</style>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;

  const splitTitle = (element: HTMLElement) => {
    if (element.dataset.motionSplit === 'true' || element.closest('.cinematic')) return;
    const text = element.textContent?.trim();
    if (!text) return;
    element.dataset.motionSplit = 'true';
    element.classList.add('motion-title');
    element.setAttribute('aria-label', text);
    element.innerHTML = text.split(/\s+/).map((word, index) => `<span class="motion-word" aria-hidden="true" style="--word-index:${index}"><span>${word}</span></span>`).join(' ');
  };

  document.querySelectorAll<HTMLElement>('.display, .section-title, .service-row h2, .expertise-card h3, .process__steps h3, .footer__tag, .prose h2, [data-motion-title]').forEach(splitTitle);

  document.querySelectorAll<HTMLElement>('.prose > *, .footer__top > *, .footer__bottom, .service-detail li, .about-principles article, .standard__metrics article').forEach((item) => item.setAttribute('data-reveal', ''));
  document.querySelectorAll<HTMLElement>('.expertise-card, .service-row, .process__steps article, .about-principles article, .standard__metrics article, .testimonial-grid figure, .prose > *').forEach((item, index) => item.style.setProperty('--reveal-index', String(index % 6)));

  const observed = document.querySelectorAll<HTMLElement>('[data-reveal], .motion-title, .eyebrow');
  observed.forEach((item) => item.classList.add('motion-observed'));

  if (reduceMotion) {
    observed.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: .12, rootMargin: '0px 0px -5% 0px' });
    observed.forEach((item) => observer.observe(item));
  }

  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const pageHero = document.querySelector<HTMLElement>('.page-hero');
  const parallaxItems = [...document.querySelectorAll<HTMLElement>('.page-hero__mark, .profile__visual > img, .about-profile__mark > img')];
  let ticking = false;
  const updateScrollMotion = () => {
    const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    progress?.style.setProperty('transform', `scaleX(${Math.min(1, scrollY / max)})`);
    pageHero?.style.setProperty('--hero-drift', `${Math.min(90, scrollY * .13)}px`);
    parallaxItems.forEach((item, index) => {
      const box = item.getBoundingClientRect();
      const offset = (box.top + box.height / 2 - innerHeight / 2) * (index === 0 ? -.035 : -.065);
      item.style.setProperty('--parallax-y', `${offset.toFixed(1)}px`);
    });
    ticking = false;
  };
  addEventListener('scroll', () => {
    if (!ticking) requestAnimationFrame(updateScrollMotion);
    ticking = true;
  }, { passive: true });
  updateScrollMotion();

  if (finePointer && !reduceMotion) {
    const cursor = document.querySelector<HTMLElement>('[data-motion-cursor]');
    let x = innerWidth / 2, y = innerHeight / 2, tx = x, ty = y;
    const follow = () => {
      x += (tx - x) * .16; y += (ty - y) * .16;
      if (cursor) cursor.style.transform = `translate3d(${x}px,${y}px,0)`;
      requestAnimationFrame(follow);
    };
    addEventListener('pointermove', (event) => { tx = event.clientX; ty = event.clientY; if (cursor) cursor.style.opacity = '1'; }, { passive: true });
    document.querySelectorAll('a, button, summary, input, textarea, select').forEach((item) => {
      item.addEventListener('pointerenter', () => cursor?.classList.add('is-active'));
      item.addEventListener('pointerleave', () => cursor?.classList.remove('is-active'));
    });
    follow();
  }

  if (finePointer && !reduceMotion) {
    document.querySelectorAll<HTMLElement>('.magnetic').forEach((item) => {
      item.addEventListener('pointermove', (event) => {
        const box = item.getBoundingClientRect();
        item.style.transform = `translate(${(event.clientX - box.left - box.width / 2) * .12}px, ${(event.clientY - box.top - box.height / 2) * .12}px)`;
      });
      item.addEventListener('pointerleave', () => item.style.transform = '');
    });
  }
</script>
