<script is:inline>
  document.documentElement.classList.add('motion-ready');
  window.setTimeout(() => {
    if (!document.documentElement.classList.contains('motion-initialized')) {
      document.documentElement.classList.remove('motion-ready');
    }
  }, 2500);
</script>

<div class="reading-progress" aria-hidden="true"><i data-scroll-progress></i></div>

<style is:global>
  .reading-progress { position: fixed; z-index: 120; inset: 0 0 auto; height: 2px; pointer-events: none; }
  .reading-progress i { display: block; width: 100%; height: 100%; background: var(--oxblood); transform: scaleX(0); transform-origin: left; will-change: transform; }
  .motion-ready [data-reveal] {
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity .55s var(--ease), transform .65s var(--ease);
    transition-delay: calc(var(--reveal-index, 0) * 55ms);
  }
  .motion-ready [data-reveal].is-visible { opacity: 1; transform: none; }
  .footer__nav a { text-underline-offset: .35em; }
  .footer__nav a:hover { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) {
    .reading-progress { display: none; }
    .motion-ready [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.documentElement.classList.add('motion-initialized');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const groups = document.querySelectorAll<HTMLElement>('.practice__list, .method__steps, .audience-grid, .services-index__list, .about-principles');
  groups.forEach((group) => {
    group.querySelectorAll<HTMLElement>(':scope > [data-reveal]').forEach((item, index) => {
      item.style.setProperty('--reveal-index', String(Math.min(index, 3)));
    });
  });

  const observed = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reduceMotion || !('IntersectionObserver' in window)) {
    observed.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: .08, rootMargin: '0px 0px -3% 0px' });
    observed.forEach((item) => observer.observe(item));
  }

  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  let ticking = false;
  const updateProgress = () => {
    const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    progress?.style.setProperty('transform', `scaleX(${Math.min(1, scrollY / max)})`);
    ticking = false;
  };
  addEventListener('scroll', () => {
    if (!ticking) requestAnimationFrame(updateProgress);
    ticking = true;
  }, { passive: true });
  updateProgress();
</script>
