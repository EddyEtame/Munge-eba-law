---
interface Props { compact?: boolean; light?: boolean; }
const { compact = false, light = false } = Astro.props;
---

<a class:list={['brand', { 'brand--compact': compact, 'brand--light': light }]} href="/" aria-label="Munge Eba & Co. Law Firm — home">
  <img src="/brand/munge-eba-logo-transparent.png" alt="Munge Eba & Co. Law Firm" width="2048" height="2048" />
</a>

<style>
  .brand { display: inline-flex; align-items: center; width: 7rem; height: 5.5rem; }
  .brand img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 .35rem .65rem rgba(0,0,0,.18)); }
  .brand--compact { width: 4rem; height: 4rem; }
  .brand--light img { filter: drop-shadow(0 .35rem .8rem rgba(0,0,0,.42)); }
  @media (max-width: 900px) { .brand { width: 6.2rem; height: 4.8rem; } }
</style>
