---
import BrandMark from './BrandMark.astro';
import { content, firm, pathFor, type Locale } from '@/lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = content[locale];
const labels = locale === 'en'
  ? { navigate: 'Navigate', contact: 'Contact', visit: 'Office', availability: 'Availability', privacy: 'Privacy', legal: 'Legal notice', remote: 'Remote consultations by appointment' }
  : { navigate: 'Navigation', contact: 'Contact', visit: 'Cabinet', availability: 'Disponibilité', privacy: 'Confidentialité', legal: 'Mentions légales', remote: 'Consultations à distance sur rendez-vous' };
---

<footer class="footer">
  <div class="container footer__identity">
    <BrandMark light href={pathFor(locale, 'home')} {locale} />
    <p>{t.footerTag}</p>
  </div>

  <div class="container footer__grid">
    <nav aria-label={labels.navigate}>
      <span>{labels.navigate}</span>
      <a href={pathFor(locale, 'services')}>{t.nav.services}</a>
      <a href={pathFor(locale, 'about')}>{t.nav.about}</a>
      <a href={pathFor(locale, 'contact')}>{t.nav.contact}</a>
    </nav>
    <div>
      <span>{labels.contact}</span>
      <a href={`tel:${firm.phoneHref}`}>{firm.phoneDisplay}</a>
      <a href={`mailto:${firm.email}`}>{firm.email}</a>
    </div>
    <div>
      <span>{labels.visit}</span>
      <address class="footer__address">{firm.address[locale]}</address>
    </div>
    <div>
      <span>{labels.availability}</span>
      <p>{firm.hours[locale]}</p>
      <p>{labels.remote}</p>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {new Date().getFullYear()} {firm.legalName}</p>
    <div><a href={pathFor(locale, 'privacy')}>{labels.privacy}</a><a href={pathFor(locale, 'legal')}>{labels.legal}</a></div>
  </div>
</footer>

<style>
  .footer { position: relative; z-index: 1; padding: 5rem 0 2rem; background: #0f0d0b; color: var(--paper-bright); }
  .footer__identity { display: flex; align-items: center; justify-content: space-between; gap: 4rem; padding-bottom: 4rem; }
  .footer__identity > p { max-width: 21ch; margin: 0; text-align: right; font: 500 clamp(1.8rem, 3.1vw, 3.6rem)/1 var(--serif); letter-spacing: -.025em; }
  .footer__grid { display: grid; grid-template-columns: .75fr 1fr 1.35fr 1fr; gap: 2.5rem; padding: 2.5rem 0 4rem; border-top: 1px solid rgba(255,255,255,.16); }
  .footer__grid > *, .footer__grid nav { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; gap: .8rem; }
  .footer__grid span { margin-bottom: .65rem; color: var(--gold-light); font-size: .61rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .footer__grid a, .footer__grid p, .footer__grid address { margin: 0; color: rgba(255,255,255,.64); font-size: .78rem; font-style: normal; line-height: 1.65; overflow-wrap: anywhere; }
  .footer__grid a:hover { color: white; }
  .footer__address { max-width: 28rem; }
  .footer__bottom { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-top: 1.8rem; border-top: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.42); font-size: .61rem; letter-spacing: .07em; text-transform: uppercase; }
  .footer__bottom p { margin: 0; }
  .footer__bottom div { display: flex; gap: 1.5rem; }
  @media(max-width: 900px) {
    .footer__grid { grid-template-columns: 1fr 1fr; row-gap: 3rem; }
  }
  @media(max-width: 600px) {
    .footer__identity { align-items: flex-start; flex-direction: column; gap: 2.5rem; }
    .footer__identity > p { max-width: 18ch; text-align: left; }
    .footer__grid { grid-template-columns: 1fr; }
    .footer__bottom { align-items: flex-start; flex-direction: column; }
  }
</style>
