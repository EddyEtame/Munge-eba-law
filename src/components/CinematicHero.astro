---
import { content, pathFor, type Locale } from '@/lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = content[locale].hero;
---

<section class="cinematic" data-cinematic>
  <canvas class="cinematic__canvas" data-portal-canvas aria-hidden="true"></canvas>
  <div class="cinematic__fallback" aria-hidden="true"></div>
  <div class="cinematic__grain" aria-hidden="true"></div>
  <div class="cinematic__intro" data-intro aria-hidden="true">
    <p data-intro-kicker>Douala · Cameroon</p>
    <img src="/brand/munge-eba-logo-transparent.png" alt="" width="640" height="640" data-intro-logo />
    <p data-intro-label>{t.enter}</p>
  </div>
  <button class="cinematic__skip" type="button" data-skip>{t.skip}</button>
  <div class="container cinematic__content" data-hero-content>
    <p class="eyebrow">{t.eyebrow}</p>
    <h1 class="display" aria-label={t.title}>{t.title.split(' ').map((word, index) => <span class="hero-word" aria-hidden="true" style={`--hero-word:${index}`}><span>{word}</span></span>)}</h1>
    <div class="cinematic__foot">
      <p>{t.body}</p>
      <div class="cinematic__actions">
        <a class="button magnetic" href={pathFor(locale, 'contact')}>{t.primary}</a>
        <a class="text-link" href="#approach">{t.secondary}<span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
  <div class="cinematic__counter" aria-hidden="true"><span>01</span><i></i><span>03</span></div>
</section>

<style>
  .cinematic { position: relative; min-height: 100svh; overflow: clip; display: grid; align-items: end; background: #14100e; color: var(--paper-bright); isolation: isolate; }
  .cinematic__canvas, .cinematic__fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cinematic__fallback { z-index: -2; background: radial-gradient(circle at 50% 42%, #8e5d28 0, #37161b 22%, #11100d 61%); }
  .cinematic__grain { position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(90deg, rgba(5,4,3,.5), transparent 48%, rgba(5,4,3,.3)), linear-gradient(0deg, rgba(5,4,3,.56), transparent 60%); }
  .cinematic__intro { position: absolute; inset: 0; z-index: 10; display: grid; place-items: center; align-content: center; gap: 1rem; background: #0e0d0b; transform-origin: center; }
  .cinematic__intro::before, .cinematic__intro::after { content: ''; position: absolute; top: 0; bottom: 0; width: 50%; background: linear-gradient(90deg, #110f0d, #241714); border-right: 1px solid rgba(198,152,61,.4); }
  .cinematic__intro::before { left: 0; }
  .cinematic__intro::after { right: 0; transform: scaleX(-1); }
  .cinematic__intro p, .cinematic__intro img { position: relative; z-index: 2; }
  .cinematic__intro img { width: min(32vw, 18rem); height: auto; filter: drop-shadow(0 1.5rem 3rem rgba(0,0,0,.45)); }
  .cinematic__intro p { margin: 0; color: var(--gold-light); font-size: .6rem; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
  .cinematic__skip { position: absolute; z-index: 15; right: 2rem; bottom: 2rem; border: 0; border-bottom: 1px solid rgba(255,255,255,.5); padding: 0 0 .35rem; background: none; color: rgba(255,255,255,.7); cursor: pointer; font-size: .58rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .cinematic__content { position: relative; z-index: 4; padding: 12rem 0 4rem; opacity: 0; transform: translateY(2rem); }
  .cinematic__content .eyebrow { margin-bottom: 2rem; color: var(--gold-light); }
  .cinematic__content h1 { max-width: 9.5ch; text-wrap: balance; }
  .hero-word { display: inline-block; overflow: hidden; margin: -.06em .1em -.12em 0; padding: .06em 0 .12em; vertical-align: top; }
  .hero-word > span { display: inline-block; transform: translateY(120%) rotate(4deg); filter: blur(7px); opacity: 0; }
  .cinematic__content.is-ready .hero-word > span { animation: hero-word-in 1.15s var(--ease) both; animation-delay: calc(var(--hero-word) * 75ms + 120ms); }
  .cinematic__content .eyebrow, .cinematic__content .cinematic__foot { opacity: 0; transform: translateY(1.2rem); }
  .cinematic__content.is-ready .eyebrow, .cinematic__content.is-ready .cinematic__foot { animation: hero-detail-in .9s var(--ease) .1s both; }
  .cinematic__content.is-ready .cinematic__foot { animation-delay: .55s; }
  @keyframes hero-word-in { to { transform: none; filter: blur(0); opacity: 1; } }
  @keyframes hero-detail-in { to { opacity: 1; transform: none; } }
  .cinematic__foot { margin-top: clamp(2.8rem, 5vw, 5rem); padding-top: 1.7rem; border-top: 1px solid rgba(255,255,255,.23); display: grid; grid-template-columns: minmax(18rem, 38rem) 1fr; align-items: end; gap: 4rem; }
  .cinematic__foot > p { margin: 0; color: rgba(255,255,255,.73); font-size: clamp(.95rem, 1.2vw, 1.16rem); line-height: 1.7; }
  .cinematic__actions { display: flex; justify-content: flex-end; align-items: center; gap: 2rem; }
  .text-link { display: inline-flex; gap: 1rem; align-items: center; font-size: .66rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .text-link span { color: var(--gold-light); font-size: 1rem; }
  .cinematic__counter { position: absolute; z-index: 5; top: 50%; right: 1.5rem; display: grid; justify-items: center; gap: .6rem; color: rgba(255,255,255,.5); font-size: .55rem; }
  .cinematic__counter i { width: 1px; height: 5rem; background: linear-gradient(var(--gold), rgba(255,255,255,.15)); }
  @media(max-width: 800px) {
    .cinematic__content { padding-bottom: 2rem; }
    .cinematic__foot { grid-template-columns: 1fr; gap: 2rem; }
    .cinematic__actions { justify-content: flex-start; }
    .cinematic__counter { display: none; }
    .cinematic__intro img { width: min(58vw, 17rem); }
  }
  @media(max-width: 560px) {
    .cinematic__actions { align-items: stretch; flex-direction: column; gap: 1.3rem; }
    .text-link { justify-content: center; }
    .cinematic__skip { right: 1rem; bottom: 1rem; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-cinematic]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-portal-canvas]');
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const contentEl = document.querySelector<HTMLElement>('[data-hero-content]');
  const skip = document.querySelector<HTMLButtonElement>('[data-skip]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let frame = 0;
  let completed = false;

  const finishIntro = (instant = false) => {
    if (completed) return;
    completed = true;
    contentEl?.classList.add('is-ready');
    const duration = instant ? 1 : 700;
    intro?.animate([{ opacity: 1 }, { opacity: 0, transform: 'scale(1.04)' }], { duration, easing: 'ease-out', fill: 'forwards' }).finished.then(() => intro.remove());
    contentEl?.animate([{ opacity: 0, transform: 'translateY(2rem)' }, { opacity: 1, transform: 'none' }], { duration: instant ? 1 : 1150, delay: instant ? 0 : 150, easing: 'cubic-bezier(.2,.72,.2,1)', fill: 'forwards' });
    skip?.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, fill: 'forwards' }).finished.then(() => skip.remove());
  };

  if (canvas && section && !reduced) {
    try {
      const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'high-performance' });
      if (!gl) throw new Error('WebGL unavailable');
      const vertexSource = `attribute vec2 aPosition; varying vec2 vUv; void main(){vUv=aPosition*.5+.5;gl_Position=vec4(aPosition,0.0,1.0);}`;
      const fragmentSource = `
          precision highp float;
          varying vec2 vUv;
          uniform float uTime;
          uniform float uOpen;
          uniform vec2 uResolution;
          uniform vec2 uPointer;
          float noise(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453123);}
          float line(vec2 p,float w){return smoothstep(w,0.0,abs(p.x));}
          void main(){
            vec2 uv=vUv;
            vec2 p=uv-.5;
            p.x*=uResolution.x/max(uResolution.y,1.0);
            float pointer=(uPointer.x-.5)*.05;
            float opening=smoothstep(0.0,1.0,uOpen);
            float doorHalf=.22+(opening*.32);
            float frame=1.0-smoothstep(.003,.012,abs(abs(p.x-pointer)-doorHalf));
            float vertical=1.0-smoothstep(.004,.016,abs(p.y+.01));
            float portal=smoothstep(doorHalf,doorHalf-.035,abs(p.x-pointer));
            vec3 exterior=mix(vec3(.035,.03,.025),vec3(.12,.075,.055),uv.y);
            exterior+=vec3(.14,.08,.04)*pow(max(0.0,1.0-length(p)*1.15),4.0);
            vec3 interior=mix(vec3(.13,.025,.035),vec3(.66,.37,.12),pow(max(0.0,1.0-length(p*vec2(1.1,.72))),3.2));
            float beams=pow(max(0.0,sin((p.x+uTime*.012)*35.0)),20.0)*.06;
            interior+=vec3(.8,.55,.2)*beams;
            vec3 color=mix(exterior,interior,portal*opening);
            color+=frame*vec3(.72,.48,.16)*(.3+.7*opening);
            color+=vertical*vec3(.08,.04,.025)*.12;
            float vignette=smoothstep(.82,.18,length((uv-.5)*vec2(.9,1.15)));
            color*=.4+.75*vignette;
            color+=(noise(gl_FragCoord.xy+uTime)-.5)*.035;
            gl_FragColor=vec4(color,1.0);
          }`;
      const compile = (type: number, source: string) => {
        const shader = gl.createShader(type);
        if (!shader) throw new Error('Shader allocation failed');
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || 'Shader compilation failed');
        return shader;
      };
      const program = gl.createProgram();
      if (!program) throw new Error('Program allocation failed');
      gl.attachShader(program, compile(gl.VERTEX_SHADER, vertexSource));
      gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragmentSource));
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program) || 'Shader link failed');
      gl.useProgram(program);
      const buffer = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
      const position = gl.getAttribLocation(program, 'aPosition');
      gl.enableVertexAttribArray(position);
      gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
      const uTime = gl.getUniformLocation(program, 'uTime');
      const uOpen = gl.getUniformLocation(program, 'uOpen');
      const uResolution = gl.getUniformLocation(program, 'uResolution');
      const uPointer = gl.getUniformLocation(program, 'uPointer');
      let open = 0;
      const pointer = { x: .5, y: .5 };
      const start = performance.now();
      const resize = () => {
        const rect = section.getBoundingClientRect();
        const ratio = Math.min(devicePixelRatio, 1.75);
        canvas.width = Math.round(rect.width * ratio);
        canvas.height = Math.round(rect.height * ratio);
        gl.viewport(0, 0, canvas.width, canvas.height);
      };
      const ease = (value: number) => value < .5 ? 4 * value * value * value : 1 - Math.pow(-2 * value + 2, 3) / 2;
      const render = (now = performance.now()) => {
        const elapsed = now - start;
        if (!completed) open = ease(Math.min(1, Math.max(0, (elapsed - 2100) / 1900)));
        gl.uniform1f(uTime, elapsed / 1000);
        gl.uniform1f(uOpen, open);
        gl.uniform2f(uResolution, canvas.width, canvas.height);
        gl.uniform2f(uPointer, pointer.x, pointer.y);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        frame = requestAnimationFrame(render);
      };
      resize(); render(); addEventListener('resize', resize);
      section.addEventListener('pointermove', (event) => {
        pointer.x += (event.clientX / innerWidth - pointer.x) * .12;
        pointer.y += (1 - event.clientY / innerHeight - pointer.y) * .12;
      });
      document.querySelector<HTMLElement>('[data-intro-kicker]')?.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 800, delay: 100, fill: 'both' });
      document.querySelector<HTMLElement>('[data-intro-logo]')?.animate([{ opacity: 0, transform: 'scale(.86)', filter: 'blur(12px)' }, { opacity: 1, transform: 'scale(1)', filter: 'blur(0)' }], { duration: 1400, delay: 250, easing: 'cubic-bezier(.2,.72,.2,1)', fill: 'both' });
      document.querySelector<HTMLElement>('[data-intro-label]')?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, delay: 1200, fill: 'both' });
      intro?.animate([{ clipPath: 'inset(0 0 0 0)' }, { clipPath: 'inset(0 50% 0 50%)' }], { duration: 1500, delay: 2500, easing: 'cubic-bezier(.65,0,.2,1)', fill: 'forwards' });
      const finishTimer = window.setTimeout(() => finishIntro(), 3600);
      skip?.addEventListener('click', () => { clearTimeout(finishTimer); open = 1; finishIntro(); });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(frame); else render();
      });
    } catch {
      canvas.remove();
      finishIntro(true);
    }
  } else {
    canvas?.remove();
    finishIntro(true);
  }
</script>
